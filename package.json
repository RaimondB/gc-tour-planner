{
  "name": "gc-tour-planner",
  "version": "0.0.0",
  "private": true,
  "description": "Plan closed-loop geocaching tours from filtered cache clusters",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaimondB/gc-tour-planner.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "scripts/dev.sh",
    "dev:down": "scripts/dev-down.sh",
    "dev:turbo": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "licenses:check": "pnpm dlx license-checker --production --summary --failOn 'SSPL-1.0;Server Side Public License;RSAL;Commons-Clause;BUSL-1.1;CC-BY-NC-4.0;CC-BY-NC-3.0'",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@gctp/config": "workspace:*",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "undici": "6.24.0",
      "path-to-regexp": "0.1.12",
      "picomatch": "4.0.4",
      "glob": "10.5.0",
      "tar-fs": "2.1.4",
      "tmp": "0.2.6",
      "lodash": "4.17.21"
    }
  }
}
