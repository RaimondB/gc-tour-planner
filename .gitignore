# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/

# TypeScript incremental build info
*.tsbuildinfo

# Turborepo
.turbo/

# Vite
.vite/

# Test output
coverage/
*.lcov
playwright-report/
test-results/
.nyc_output/

# Editor / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local Claude Code scratch (debug exports, transcripts, etc.)
# `.claude/settings.json` is project-wide tooling config and IS tracked.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**

# Env
.env
.env.*.local
!.env.example
infra/.env
scripts/dev.env

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# OSRM preprocessed data (large, regenerated by bootstrap)
infra/osrm/data/

# Local dev-only on-host data (raw GPX uploads, etc.). In the docker
# compose stacks this lives in a named volume; the dev script bind-
# mounts it under ./data/uploads so it survives `pnpm dev:down` but
# never reaches the repo.
data/

# Local databases
*.sqlite
*.sqlite-journal
