#
# Multi-stage build for @gctp/web. Build-time env is baked into the static
# bundle via VITE_* args.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
ARG VITE_API_URL
ARG VITE_MAP_STYLE_URL
ARG VITE_TURNSTILE_SITE_KEY
ARG VITE_CF_WEB_ANALYTICS_TOKEN
ARG VITE_APP_ENV
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_MAP_STYLE_URL=${VITE_MAP_STYLE_URL}
ENV VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}
ENV VITE_CF_WEB_ANALYTICS_TOKEN=${VITE_CF_WEB_ANALYTICS_TOKEN}
ENV VITE_APP_ENV=${VITE_APP_ENV}
COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @gctp/shared build \
 && pnpm --filter @gctp/web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
