#
# One-shot DB migration runner. Mounted with the repo's migrations dir
# (read-only) and invoked from docker compose on every `up`; exits 0
# when there are no pending migrations (node-pg-migrate is idempotent),
# blocking dependent services until migrations are applied.
#
# Why a dedicated image rather than reusing Dockerfile.api: the api
# image is built with `pnpm deploy --prod`, which strips dev deps
# (node-pg-migrate is one), so the binary isn't on PATH inside the api
# container. This image installs just node-pg-migrate + pg globally and
# nothing else, so the image is tiny (~150 MB) and the deploy story
# stays decoupled from api build internals.
#
# Versions pinned to packages/db/package.json's devDependencies — bump
# them in lockstep.

FROM node:22-bookworm-slim
WORKDIR /app
RUN npm install --omit=dev -g node-pg-migrate@7.6.1 pg@8.13.1 \
 && npm cache clean --force
# DATABASE_URL is supplied via the compose service's environment block.
# `--migration-filename-format utc` matches packages/db/package.json
# so the same migration files work in both dev (host-run via pnpm) and
# UAT (this container).
CMD ["node-pg-migrate", "up", \
     "--migrations-dir", "/migrations", \
     "--migration-filename-format", "utc"]
