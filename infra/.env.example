# Copy to infra/.env and edit. infra/.env is gitignored.

# --- Postgres (postgis/postgis:16-3.4) ---
POSTGRES_USER=gctp
POSTGRES_PASSWORD=gctp-dev
POSTGRES_DB=gctp
POSTGRES_PORT=5432

# --- Valkey (valkey/valkey:8) ---
VALKEY_PORT=6379

# --- OSRM (foot profile) ---
# Region(s) to preprocess on first boot.
#
# Prefer OSRM_REGIONS (plural, comma-separated) when your caches straddle the
# boundary of a single Geofabrik extract — the bootstrap script downloads each
# region and merges them with `osmium merge` before extract. This avoids the
# classic "OSRM detours 20 km through the neighbouring country because half
# the road network isn't loaded" failure mode.
#
# Single region examples (sets OSRM_REGION instead):
#   europe/netherlands
#   north-america/us/california
#   europe/great-britain
#
# Multi-region example (cross-border caches, e.g. NL + the bit of Germany at
# the Emmerich / Klein-Netterden border):
#   OSRM_REGIONS=europe/netherlands,europe/germany/nordrhein-westfalen
#
# Set ONE of these — OSRM_REGIONS wins if both are present.
OSRM_REGION=europe/netherlands
# OSRM_REGIONS=europe/netherlands,europe/germany/nordrhein-westfalen
OSRM_PORT=5000
# --max-table-size for osrm-routed. Default is 100; the tour planner sends
# the full candidate pool (capped at 300) to /table during cluster discovery.
OSRM_MAX_TABLE_SIZE=5000
# osrm-routed worker threads. Defaults to the host's hardware threads
# which can saturate the box under load. NUC8i7BEH is 4C/8T; 4 leaves
# headroom for postgres + api. Raise for higher single-tenant
# throughput, lower if OSRM crowds out the rest of the stack.
OSRM_THREADS=4
# Global cap on concurrent OSRM requests across the API process. Bound
# by HttpOsrmClient — surplus requests queue. Bumping higher trades
# multi-user fairness for single-tenant throughput; lower trades the
# reverse.
OSRM_MAX_CONCURRENCY=8

# --- API ---
# Default 3030 (not 3000) to avoid clashing with another service / other dashboards
# that conventionally bind 3000 on dev machines.
API_PORT=3030
DATABASE_URL=postgresql://gctp:gctp-dev@postgres:5432/gctp
VALKEY_URL=redis://valkey:6379
OSRM_URL=http://osrm:5000
JWT_SECRET=replace-me-with-a-long-random-string
# Tour planner strategy. `greedy` is the pure-TS default; `solver` routes
# Pass 2 to the Timefold sidecar (ADR-0005). `solver` requires the `solver`
# service to be healthy (compose enforces this).
TOUR_PLANNER=greedy
SOLVER_URL=http://solver:8080
LOG_LEVEL=info

# --- Solver sidecar (Timefold, infra/solver/) ---
# Host-side port mapping. The api talks to the solver via SOLVER_URL above
# (compose-internal DNS), so SOLVER_PORT only matters for direct curl from the
# host.
SOLVER_PORT=8088
# Termination caps. The solver exits as soon as the score stops improving for
# SOLVER_UNIMPROVED_LIMIT (typical exit: well under 1s on small clusters), with
# SOLVER_SPENT_LIMIT as a hard ceiling for pathological cases. Determinism
# comes from timefold.solver.environment-mode=REPRODUCIBLE in the sidecar's
# application.properties — no RNG seed env var to set.
SOLVER_UNIMPROVED_LIMIT=500ms
SOLVER_SPENT_LIMIT=5s

# --- osm2pgsql landuse import (ADR-0009) ---
# Set to 1 to force a full re-import of landuse_polygons on the next
# `docker compose up osm2pgsql-import`. Leave empty for the normal
# short-circuit-on-existing-metadata-row behaviour. The admin endpoint
# `POST /admin/landuse/reimport` enqueues a heartbeat-only replication
# job — for a full re-import use this env var + recreate the container.
LANDUSE_FORCE_REIMPORT=
# osm2pgsql tuning. Defaults pick a memory-safe profile on a 16 GB host.
#   OSM2PGSQL_CACHE     — MB for in-RAM node-id → location lookups.
#                         1024+ ≈ 25-40% faster, costs ~+800 MB peak.
#   OSM2PGSQL_PROCESSES — parallel workers. host has 4C/8T; 4 is memory-safe,
#                         8 uses hyperthreads for ~10-15% extra speed.
#   OSM2PGSQL_EXTRA     — extra free-form flags. Example for a fast non-slim
#                         import (~3× speed, ~5-6 GB RAM, loses replication
#                         support — re-bootstrap after region changes):
#                         OSM2PGSQL_EXTRA="--cache 4096"  (and edit
#                         infra/osm2pgsql/bootstrap.sh to drop --slim).
OSM2PGSQL_CACHE=256
OSM2PGSQL_PROCESSES=4
OSM2PGSQL_EXTRA=

# --- Web (built into the static bundle at build time) ---
VITE_API_URL=http://localhost:3030
# Optional: MapLibre style URL. Falls back to a raster OSM source if unset.
# VITE_MAP_STYLE_URL=https://tiles.example/style.json
WEB_PORT=5173

# --- Groundspeak (M8, feature-flagged off by default) ---
# GC_PARTNER_KEY=

# --- Public exposure: dedicated Cloudflare Tunnel (ADR-0015) ---
# Token for gctp's OWN named tunnel. Create
# it in the Cloudflare Zero Trust dashboard (Networks > Tunnels > Create a
# tunnel > Cloudflared), copy the connector token here, then add a Public
# Hostname route `app.example.com -> http://web:80` and a Cloudflare
# Access application protecting that hostname. Leave blank for purely local
# `pnpm dev` work — the cloudflared service just restart-loops without it.
CLOUDFLARE_TUNNEL_TOKEN=
