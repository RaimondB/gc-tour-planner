# Copy to infra/.env and edit. infra/.env is gitignored.

# --- Postgres (postgis/postgis:16-3.4) ---
POSTGRES_USER=gctp
POSTGRES_PASSWORD=gctp-dev
POSTGRES_DB=gctp
POSTGRES_PORT=5432

# --- Valkey (valkey/valkey:8) ---
VALKEY_PORT=6379

# --- OSRM (foot profile) ---
# Region to preprocess on first boot. Override per-deployment.
# Example values:
#   europe/netherlands
#   north-america/us/california
#   europe/great-britain
OSRM_REGION=europe/netherlands
OSRM_PORT=5000
# --max-table-size for osrm-routed. Default is 100; the tour planner sends
# the full candidate pool (capped at 300) to /table during cluster discovery.
OSRM_MAX_TABLE_SIZE=5000

# --- API ---
# Default 3030 (not 3000) to avoid clashing with another service / other dashboards
# that conventionally bind 3000 on dev machines.
API_PORT=3030
DATABASE_URL=postgresql://gctp:gctp-dev@postgres:5432/gctp
VALKEY_URL=redis://valkey:6379
OSRM_URL=http://osrm:5000
OVERPASS_URL=https://overpass-api.de/api/interpreter
JWT_SECRET=replace-me-with-a-long-random-string
# Tour planner strategy. `greedy` is the pure-TS default; `solver` routes
# Pass 2 to the Timefold sidecar (ADR-0005). `solver` requires the `solver`
# service to be healthy (compose enforces this).
TOUR_PLANNER=greedy
SOLVER_URL=http://solver:8080
LOG_LEVEL=info

# --- Solver sidecar (Timefold, infra/solver/) ---
# Host-side port mapping. The api talks to the solver via SOLVER_URL above
# (compose-internal DNS), so SOLVER_PORT only matters for direct curl from the
# host.
SOLVER_PORT=8088
# Termination caps. The solver exits as soon as the score stops improving for
# SOLVER_UNIMPROVED_LIMIT (typical exit: well under 1s on small clusters), with
# SOLVER_SPENT_LIMIT as a hard ceiling for pathological cases. Determinism
# comes from timefold.solver.environment-mode=REPRODUCIBLE in the sidecar's
# application.properties — no RNG seed env var to set.
SOLVER_UNIMPROVED_LIMIT=500ms
SOLVER_SPENT_LIMIT=5s

# --- Web (built into the static bundle at build time) ---
VITE_API_URL=http://localhost:3030
# Optional: MapLibre style URL. Falls back to a raster OSM source if unset.
# VITE_MAP_STYLE_URL=https://tiles.example/style.json
WEB_PORT=5173

# --- Groundspeak (M8, feature-flagged off by default) ---
# GC_PARTNER_KEY=
