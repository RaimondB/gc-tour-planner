#
# Multi-stage build for @gctp/api.
# Context: repo root (so we can copy the whole pnpm workspace).

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages packages
COPY apps/api apps/api
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @gctp/shared build \
 && pnpm --filter @gctp/db build \
 && pnpm --filter @gctp/api build
RUN pnpm deploy --filter @gctp/api --prod /out

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
COPY --from=build /out ./
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "dist/main.js"]
