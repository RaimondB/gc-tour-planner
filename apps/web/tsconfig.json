{
  "extends": "@gctp/config/tsconfig.react.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "types": ["vite/client"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "e2e",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
