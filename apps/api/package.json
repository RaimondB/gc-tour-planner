{
  "name": "@gctp/api",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "rm -rf dist && tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/test/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bull-board/api": "6.5.0",
    "@bull-board/express": "6.5.0",
    "@gctp/db": "workspace:*",
    "@gctp/shared": "workspace:*",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "8.0.7",
    "bullmq": "5.34.0",
    "express": "4.21.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "h3-js": "^4.4.0",
    "kysely": "0.28.17",
    "nestjs-zod": "4.2.0",
    "pino": "9.5.0",
    "piscina": "^5.1.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@gctp/config": "workspace:*",
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@testcontainers/postgresql": "10.16.0",
    "@types/express": "5.0.0",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.1",
    "eslint": "9.15.0",
    "supertest": "7.0.0",
    "testcontainers": "10.16.0",
    "ts-loader": "9.5.1",
    "tsc-watch": "6.2.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
