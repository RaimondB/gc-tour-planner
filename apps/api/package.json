{
  "name": "@gctp/api",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "rm -rf dist && tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/test/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bull-board/api": "7.1.5",
    "@bull-board/express": "7.1.5",
    "@gctp/db": "workspace:*",
    "@gctp/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/swagger": "11.4.4",
    "bullmq": "5.78.0",
    "express": "5.2.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "h3-js": "^4.4.0",
    "kysely": "0.29.2",
    "nestjs-zod": "5.4.0",
    "pino": "10.3.1",
    "piscina": "^5.1.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@gctp/config": "workspace:*",
    "@nestjs/cli": "11.0.21",
    "@nestjs/testing": "11.1.24",
    "@testcontainers/postgresql": "12.0.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "22.10.1",
    "eslint": "9.15.0",
    "supertest": "7.0.0",
    "testcontainers": "12.0.1",
    "ts-loader": "9.5.1",
    "tsc-watch": "6.2.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
