#
# Copy to apps/api/.env when running the API on the host (pnpm --filter @gctp/api dev).
# The compose `api` service uses infra/.env instead — those defaults point to
# the in-network hostnames (postgres, valkey, osrm) and should not be copied here.

API_PORT=3030

# Postgres + PostGIS exposed by docker compose on the host's localhost:5432
DATABASE_URL=postgresql://gctp:gctp-dev@localhost:5432/gctp

# OSRM container exposed by docker compose on the host's localhost:5000.
# Inside compose this would be http://osrm:5000.
OSRM_URL=http://localhost:5000

# Valkey for BullMQ (M4-β); harmless to set even before queues exist.
VALKEY_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave unset in dev — Vite proxies /api → :3030 so the browser only talks to
# its own origin. Set in production deploys where the web bundle is hosted
# on a different origin from the API. Example: CORS_ORIGINS=https://app.example.com
# CORS_ORIGINS=
