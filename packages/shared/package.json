{
  "name": "@gctp/shared",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tours": {
      "types": "./dist/tours/index.d.ts",
      "import": "./dist/tours/index.js"
    },
    "./caches": {
      "types": "./dist/caches/index.d.ts",
      "import": "./dist/caches/index.js"
    },
    "./geo": {
      "types": "./dist/geo/index.d.ts",
      "import": "./dist/geo/index.js"
    },
    "./gpx": {
      "types": "./dist/gpx/index.d.ts",
      "import": "./dist/gpx/index.js"
    },
    "./landuse": {
      "types": "./dist/landuse/index.d.ts",
      "import": "./dist/landuse/index.js"
    },
    "./landuse-profiles": {
      "types": "./dist/landuse-profiles/index.d.ts",
      "import": "./dist/landuse-profiles/index.js"
    },
    "./parking-facilities": {
      "types": "./dist/parking-facilities/index.d.ts",
      "import": "./dist/parking-facilities/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.js"
    },
    "./tsp": {
      "types": "./dist/tsp/index.d.ts",
      "import": "./dist/tsp/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./adventure-labs": {
      "types": "./dist/adventure-labs/index.d.ts",
      "import": "./dist/adventure-labs/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "fast-xml-parser": "5.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gctp/config": "workspace:*",
    "eslint": "9.39.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
