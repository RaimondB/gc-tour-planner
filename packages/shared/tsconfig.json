{
  // Relative extends (not the "@gctp/config/..." specifier): Vite 8's oxc transform
  // resolves nested tsconfig "extends" against the pnpm symlink dir instead of the
  // package's real path, so the package-specifier form breaks vitest. tsc handles
  // either; relative keeps both happy. (db is the only tsc-only package left.)
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
