{
  "name": "@gctp/db",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo '(no unit tests yet — integration tests live in apps/api/test/)'",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --migration-filename-format utc",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migration-filename-format utc",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql --migration-filename-format utc",
    "generate-types": "echo 'TODO: wire kysely-codegen against $DATABASE_URL'",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "kysely": "0.27.4",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@gctp/config": "workspace:*",
    "@types/node": "22.10.1",
    "@types/pg": "8.11.10",
    "eslint": "9.15.0",
    "node-pg-migrate": "7.6.1",
    "typescript": "5.6.3"
  }
}
